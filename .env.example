# Optional: location search and global Air Quality / Pollen APIs.
# Keep this key on the server. Restrict it to the required APIs in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Maximum upstream requests per server process per hour (includes retries/errors).
API_UPSTREAM_LIMIT_PER_HOUR=200
PORT=3000
# Set to production after running npm run build when deploying.
# NODE_ENV=production
